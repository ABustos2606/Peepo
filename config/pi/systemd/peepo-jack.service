# The audio server. Restarting it restarts the engine and the MIDI services
# too (its clients).
[Unit]
Description=Peepo audio server (JACK)
PartOf=peepo.target
Wants=peepo-engine.service peepo-a2j.service peepo-midi.service
# Keep retrying if the USB interface is absent or arrives after boot.
StartLimitIntervalSec=0

[Service]
Type=simple
User=peepo
EnvironmentFile=/etc/peepo/peepo.conf
Environment=JACK_NO_AUDIO_RESERVATION=1
ExecStart=/usr/bin/jackd $JACK_OPTIONS -d $JACK_DRIVER $JACK_DRIVER_OPTIONS
# JACK is ready when it answers.
ExecStartPost=/bin/sh -c 'for i in $(seq 50); do jack_lsp >/dev/null 2>&1 && exit 0; sleep 0.1; done; exit 1'
LimitRTPRIO=95
LimitMEMLOCK=infinity
Restart=on-failure
RestartSec=2
