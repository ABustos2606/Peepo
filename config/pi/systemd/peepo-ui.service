# The touch interface. It only wants the engine: stopping or restarting it
# never touches the engine, and it reconnects by itself when the engine
# restarts.
[Unit]
Description=Peepo touch interface
PartOf=peepo.target
Wants=peepo-engine.service
After=peepo-engine.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=peepo
StateDirectory=peepo
EnvironmentFile=/etc/peepo/peepo.conf
ExecStart=/opt/peepo/bin/peepo --engine unix:///run/peepo/ingen.sock --patches /var/lib/peepo/patches --files /var/lib/peepo/files --controls /etc/peepo/controls.conf --midi /var/lib/peepo/midi.conf --midi-status /run/peepo-midi $UI_OPTIONS
Restart=always
RestartSec=1
