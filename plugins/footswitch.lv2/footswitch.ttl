@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix lv2: <http://lv2plug.in/ns/lv2core#> .

<urn:peepo:lv2:footswitch>
	a lv2:Plugin , lv2:UtilityPlugin ;
	doap:name "Footswitch" ;
	doap:license <http://usefulinc.com/doap/licenses/gpl> ;
	lv2:optionalFeature lv2:hardRTCapable ;
	lv2:port [
		a lv2:InputPort , lv2:ControlPort ;
		lv2:index 0 ;
		lv2:symbol "pressed" ;
		lv2:name "Pressed" ;
		lv2:portProperty lv2:toggled ;
		lv2:default 0 ;
		lv2:minimum 0 ;
		lv2:maximum 1
	] , [
		a lv2:InputPort , lv2:ControlPort ;
		lv2:index 1 ;
		lv2:symbol "stomp" ;
		lv2:name "Stomp" ;
		lv2:portProperty lv2:integer ;
		lv2:default 0 ;
		lv2:minimum 0 ;
		lv2:maximum 3
	] , [
		a lv2:InputPort , lv2:ControlPort ;
		lv2:index 2 ;
		lv2:symbol "latching" ;
		lv2:name "Latching" ;
		lv2:portProperty lv2:toggled ;
		lv2:default 0 ;
		lv2:minimum 0 ;
		lv2:maximum 1
	] , [
		a lv2:InputPort , lv2:ControlPort ;
		lv2:index 3 ;
		lv2:symbol "on_value" ;
		lv2:name "On value" ;
		lv2:default 1 ;
		lv2:minimum 0 ;
		lv2:maximum 1
	] , [
		a lv2:InputPort , lv2:ControlPort ;
		lv2:index 4 ;
		lv2:symbol "off_value" ;
		lv2:name "Off value" ;
		lv2:default 0 ;
		lv2:minimum 0 ;
		lv2:maximum 1
	] , [
		a lv2:OutputPort , lv2:CVPort ;
		lv2:index 5 ;
		lv2:symbol "out" ;
		lv2:name "Value"
	] .
