+	// Peepo: beat repeat's clock. From the patch tempo (BPM and Clock note)
+	// unless Clock from Trigger in is on. A block ends where the next tick
+	// falls, so the firmware measures the clock to the sample.
+	const bool tempo_clock = amp->beat_repeat && *(amp->clock_in_param) < 0.5f;
+	double tick_samples = 0.0;
+	if (tempo_clock) {
+		int note = (int)(*(amp->clock_note_param) + 0.5f);
+		note = note < 0 ? 0 : (note > 4 ? 4 : note);
+		const float bpm = clamp(*(amp->bpm_param), 30.0f, 300.0f);
+		tick_samples = amp->rate * 60.0 / bpm * kClockNoteBeats[note];
+		if (amp->samples_to_tick > tick_samples) {
+			amp->samples_to_tick = tick_samples;
+		}
+	}
+
