+			// Poly named for them; the stepped ones are choices here.
+			p->kammerl.probability = blend_value;
+			p->kammerl.clock_divider = clamp(spread_param / 3.0f + spread[j], 0.0f, 1.0f);
+			p->kammerl.pitch_mode = clamp(feedback_param / 4.0f + feedback[j], 0.0f, 1.0f);
+			p->kammerl.slice_modulation = clamp(texture_param / 7.0f, 0.0f, 1.0f);
+			p->kammerl.slice_selection = clamp(texture[j], 0.0f, 1.0f);
+			p->kammerl.size_modulation = p->density;
+			// Speed of the repeats: Pitch in semitones, 0 plays them as
