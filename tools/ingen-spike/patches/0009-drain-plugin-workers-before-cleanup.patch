+bool
+LV2Block::begin_work()
+{
+	auto state = _work_state.load(std::memory_order_acquire);
+	do {
+		if (state & work_stopping) {
+			return false;
+		}
+	} while (!_work_state.compare_exchange_weak(state, state + 1,
+	                                            std::memory_order_acq_rel));
+	return true;
+}
+
+void
+LV2Block::stop_work()
+{
+	_work_state.fetch_or(work_stopping, std::memory_order_acq_rel);
+	while ((_work_state.load(std::memory_order_acquire) & ~work_stopping) != 0) {
+		std::this_thread::sleep_for(std::chrono::milliseconds(1));
+	}
+}
