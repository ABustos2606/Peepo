+/** Peepo: the spill bypass.
+
+    While bypassed, the plugin reads silence and its output (the tail) is
+    added to the dry signal: bypassed output = input + plugin(silence). Going
+    in or out of bypass, the plugin's input fades over 5 ms and the dry signal
+    is crossfaded in the same time, so neither way clicks. Once the tail has
+    stayed below -90 dBFS for a second, the block falls back to the dumb
+    bypass and stops costing CPU; its buffer is silent by then, so switching
+    it on again brings nothing old back. */
+void
+BlockImpl::prepare_spill(SampleCount block_length, SampleRate rate)
+{
+	_spill_slot.assign(num_ports(), -1);
+	int32_t n_inputs = 0;
+	for (uint32_t i = 0; i < num_ports(); ++i) {
+		const PortImpl* const port = _ports->at(i);
+		if (port && port->is_input() && port->type() == PortType::AUDIO) {
+			_spill_slot[i] = n_inputs++;
+		}
+	}
+
+	_spill_frames = block_length;
+	_spill_voices = _polyphony;
+	_spill_step   = 1.0f / (0.005f * static_cast<float>(rate));
+	_spill_sleep  = rate;
+	_spill_buf.assign(static_cast<size_t>(n_inputs) * _spill_voices * _spill_frames, 0.0f);
+}
+
+bool
+BlockImpl::spill_ready(const RunContext& ctx) const
+{
+	return !_spill_buf.empty() && _polyphony <= _spill_voices &&
+	       ctx.nframes() <= _spill_frames;
+}
+
+Sample*
+BlockImpl::spill_input(uint32_t voice, uint32_t port_num)
+{
+	if (!_spilling || port_num >= _spill_slot.size() || _spill_slot[port_num] < 0) {
+		return nullptr;
+	}
+	const size_t slot = static_cast<size_t>(_spill_slot[port_num]);
+	return _spill_buf.data() + ((slot * _spill_voices) + voice) * _spill_frames;
+}
+
+/** The mix at the end of `frame`: 0 when on, 1 when bypassed. */
+float
+BlockImpl::spill_mix_at(SampleCount frame) const
+{
+	const float target = _enabled ? 0.0f : 1.0f;
+	const float moved  = _spill_step * static_cast<float>(frame + 1);
+	return target > _spill_mix ? std::min(target, _spill_mix + moved)
+	                           : std::max(target, _spill_mix - moved);
+}
+
+/** The dry signal for audio output `output`: the matching audio input, else
+    the last one (mono in, stereo out), else none. */
+const PortImpl*
+BlockImpl::dry_input(uint32_t output)
+{
+	const PortImpl* last = nullptr;
+	for (uint32_t i = 0;; ++i) {
+		const PortImpl* const in = nth_port_by_type(i, true, PortType::AUDIO);
+		if (!in) {
+			return last;
+		}
+		if (i == output) {
+			return in;
+		}
+		last = in;
+	}
+}
+
+/** Fill the plugin's inputs from `begin` to `end`, faded by the mix. */
+void
+BlockImpl::spill_inputs(SampleCount begin, SampleCount end)
+{
+	for (uint32_t i = 0; i < _spill_slot.size(); ++i) {
+		if (_spill_slot[i] < 0) {
+			continue;
+		}
+		const PortImpl* const port = _ports->at(i);
+		for (uint32_t v = 0; v < _polyphony; ++v) {
+			const Sample* const in  = port->buffer(v)->samples();
+			Sample* const       out = spill_input(v, i);
+			for (SampleCount f = begin; f < end; ++f) {
+				out[f] = in[f] * (1.0f - spill_mix_at(f));
+			}
+		}
+	}
+}
+
+/** Add the dry signal to the plugin's output, and put the block to sleep once
+    its tail has ended. */
+void
+BlockImpl::finish_spill(RunContext& ctx)
+{
+	const SampleCount n       = ctx.nframes();
+	const bool        settled = !_enabled && _spill_mix >= 1.0f;
+
+	float peak = 0.0f;
+	if (settled) {
+		for (uint32_t i = 0; _ports && i < _ports->size(); ++i) {
+			const PortImpl* const port = _ports->at(i);
+			if (port->type() != PortType::AUDIO || !port->is_output()) {
+				continue;
+			}
+			for (uint32_t v = 0; v < _polyphony; ++v) {
+				const Sample* const s = port->buffer(v)->samples();
+				for (SampleCount f = 0; f < n; ++f) {
+					peak = std::max(peak, std::fabs(s[f]));
+				}
+			}
+		}
+	}
+
+	// The output level applies to the plugin's sound, not to the dry signal.
+	apply_output_gain(ctx);
+
+	for (uint32_t o = 0;; ++o) {
+		const PortImpl* const out = nth_port_by_type(o, false, PortType::AUDIO);
+		if (!out) {
+			break;
+		}
+		const PortImpl* const dry = dry_input(o);
+		if (!dry) {
+			continue;
+		}
+		for (uint32_t v = 0; v < _polyphony; ++v) {
+			Sample* const       s = out->buffer(v)->samples();
+			const Sample* const d = dry->buffer(v)->samples();
+			for (SampleCount f = 0; f < n; ++f) {
+				s[f] += spill_mix_at(f) * d[f];
+			}
+		}
+	}
+
+	if (settled && peak < 3.1623e-5f) { // -90 dBFS
+		_spill_quiet += n;
+		_spill_asleep = _spill_quiet >= _spill_sleep;
+	} else {
+		_spill_quiet = 0;
+	}
+	_spill_mix = spill_mix_at(n - 1);
+}
+
