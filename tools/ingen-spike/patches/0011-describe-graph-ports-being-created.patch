+	// Enqueue ports, in index order, from the lists the pre-processor keeps.
+	// The ports array belongs to the process thread and grows only when a
+	// port's creation is executed, so a graph described straight after ports
+	// were created (a Get after loading a patch) read past its end.
+	std::vector<const PortImpl*> ports;
+	for (const auto& p : graph->inputs()) {
+		ports.push_back(&p);
+	}
+	for (const auto& p : graph->outputs()) {
+		ports.push_back(&p);
+	}
+	std::sort(ports.begin(), ports.end(), [](const PortImpl* x, const PortImpl* y) {
+		return x->index() < y->index();
+	});
+	for (const auto* p : ports) {
+		put_port(p);
 	}
 
